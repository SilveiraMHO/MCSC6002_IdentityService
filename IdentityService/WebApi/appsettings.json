{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Password from .env via docker-compose.
    "DefaultConnection": "Server=sqlserver,1433;Database=MCSC6002_IdentityDB;User Id=sa;Encrypt=True;TrustServerCertificate=True;"
  },
  "TokenSettings": {
    "PrivateKeyPath": "/keys/jwt-private.pem",
    "TokenExpireInMinutes": 15,
    "RefreshTokenExpireInDays": 1
  },
  "MutualTls": {
    "ServerCertificatePath": "/keys/identity.pfx",
    "CaCertificatePath": "/keys/ca.crt",
    "AllowedClientName": "api-gateway"
  },
  "SeedDatabase": false, // Migrations and seed users; docker-compose sets true.
  "SeedCredentials": {
    // Passwords from .env via docker-compose.
    "AdminEmail": "admin@cloudbase.com",
    "BasicEmail": "basic@cloudbase.com"
  },
  "AllowedHosts": "*"
}
